# Copiá este archivo como .env en la raíz del proyecto:
#
#   Copy-Item .env.docker.example .env     (PowerShell)
#   cp .env.docker.example .env            (Linux/macOS)
#
# Generá SECRET_KEY con el comando PowerShell documentado en el README.

SECRET_KEY=

# development muestra la ayuda y los usuarios de prueba en GET /.
# En un servidor público cambialo a production.
APP_ENV=development

TOKEN_LIFETIME=3600

# Clave de cifrado propia de Laravel (es distinta de SECRET_KEY).
# Generala con el comando PowerShell documentado en el README principal.
LARAVEL_APP_KEY=
LARAVEL_APP_DEBUG=true

# En localhost debe ser false porque se usa HTTP. En producción debe ser true
# y la aplicación debe publicarse exclusivamente mediante HTTPS.
LARAVEL_SESSION_SECURE=false

# Origen del frontend autorizado para enviar cookies en los niveles 2 y 3.
FRONTEND_ORIGIN=http://localhost:5173

# Credenciales de la base que existe únicamente dentro de Docker.
DB_PASSWORD=utu_password
MYSQL_ROOT_PASSWORD=root_password

# Puertos publicados en la computadora.
NIVEL_1_PORT=8001
NIVEL_2_PORT=8002
NIVEL_3_PORT=8003
MYSQL_PORT=3307
