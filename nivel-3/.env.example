# ============================================================================
# CONFIGURACIÓN LOCAL DEL NIVEL 3
# ============================================================================
# Copiá este archivo como .env. El .env real no se sube a Git.
#
# AVISO: este nivel fue creado con ayuda de IA y puede contener errores.
# Si usás Laravel, investigá su documentación oficial y aprendé por tu cuenta.
# ============================================================================

APP_NAME="API Productos UTU - Nivel 3"

# development muestra la ayuda educativa en /. production muestra lo mínimo.
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_UY

# Frontend SPA autorizado. En desarrollo suele ejecutarse con Vite en 5173.
FRONTEND_ORIGIN=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8003,127.0.0.1:5173,127.0.0.1:8003

# MySQL publicado por el compose principal en el puerto 3307.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=utu_demo
DB_USERNAME=utu_user
DB_PASSWORD=utu_password

# Para esta API básica no necesitamos Redis ni procesos de colas.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=nivel_3_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=debug
