# Copiá este archivo como .env en la raíz del proyecto:
#
#   Copy-Item .env.docker.example .env     (PowerShell)
#   cp .env.docker.example .env            (Linux/macOS)
#
# Generá SECRET_KEY con:
#
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

SECRET_KEY=
TOKEN_LIFETIME=3600

# Origen del frontend autorizado para enviar la cookie de nivel 2.
FRONTEND_ORIGIN=http://localhost:5173

# Credenciales de la base que existe únicamente dentro de Docker.
DB_PASSWORD=utu_password
MYSQL_ROOT_PASSWORD=root_password

# Puertos publicados en la computadora.
NIVEL_1_PORT=8001
NIVEL_2_PORT=8002
MYSQL_PORT=3307
